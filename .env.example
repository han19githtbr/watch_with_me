// .env.local
# .env.example
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/watchwithme?retryWrites=true&w=majority&appName=watchwithme
JWT_SECRET=your_jwt_secret_here
OMDB_API_KEY=your_omdb_api_key_here
NEXTAUTH_URL=http://localhost:3000

# Comma-separated allowlist of the ONLY emails allowed to use /admin,
# regardless of what the "role" field in the database says. This is a
# second, independent lock on top of the role check: even if the
# "role" field is ever changed by mistake (or by someone with direct
# database access), the admin panel still refuses anyone whose email
# isn't on this list. Leave it empty/unset to rely on role alone
# (not recommended for production).
ADMIN_EMAILS=your-email@example.com